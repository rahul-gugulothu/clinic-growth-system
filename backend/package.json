{
  "name": "@cgs/backend",
  "version": "0.1.0",
  "description": "Clinic Growth System - MVP Backend API Server",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/workers/integrationWorker.js",
    "dev:worker": "tsx watch src/workers/integrationWorker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "migrate:reset": "node-pg-migrate reset",
    "migrate:status": "node-pg-migrate list"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.16.13",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "node-pg-migrate": "^7.0.1",
    "pg-mem": "^2.2.2",
    "supertest": "^7.2.2",
    "tsx": "^4.6.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.0"
  },
  "node-pg-migrate": {
    "dir": "migrations",
    "databaseUrl": {
      "ENV": "DATABASE_URL"
    }
  }
}
