# Environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Logging ---
LOG_LEVEL=info

# --- Authentication ---
# JWT signing secrets — required in production. Must be strong random strings.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Token expiry (jsonwebtoken duration strings)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Frontend origin allowed to make requests to this API.
# Comma-separated list for multiple origins.
CORS_ORIGIN=http://localhost:5173

# --- Rate Limiting (auth-sensitive endpoints) ---
# Max auth attempts per window per IP (default: 5 per minute)
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

 # --- AI Service ---
# AI tools are deterministic (SQL-based). LLM integration is not yet implemented.
# OPENAI_API_KEY=  # Used only when LLM_PROVIDER=openai
LLM_PROVIDER=mock  # mock | openai

# --- Integrations ---
# SendGrid email provider credentials are stored encrypted via integration config.
# See: PUT /api/v1/integrations/config and GET /api/v1/integrations/health
# WHATSAPP_BUSINESS_TOKEN=

# --- Integration Configuration Encryption (V3.1.2-C1) ---
# AES-256-GCM key for encrypting integration provider credentials at rest.
# Must be a 64-character hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required when using integration configuration storage.
INTEGRATION_ENCRYPTION_KEY=

# --- Integration Worker (V3.1.3-A) ---
# Interval between due-event processing cycles, in milliseconds.
INTEGRATION_WORKER_INTERVAL_MS=30000
# Number of due integration events processed per cycle.
INTEGRATION_WORKER_BATCH_SIZE=50
# Maximum time (ms) to wait for an in-flight cycle to finish during
# graceful shutdown before forcing shutdown.
INTEGRATION_WORKER_SHUTDOWN_TIMEOUT_MS=30000
