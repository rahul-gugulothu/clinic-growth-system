# Environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Logging ---
LOG_LEVEL=info

# --- Authentication ---
# JWT signing secrets — required in production. Must be strong random strings.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Token expiry (jsonwebtoken duration strings)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Frontend origin allowed to make requests to this API.
# Comma-separated list for multiple origins.
CORS_ORIGIN=http://localhost:5173

# --- Rate Limiting (auth-sensitive endpoints) ---
# Max auth attempts per window per IP (default: 5 per minute)
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# --- AI Service (not implemented in V3.0.4) ---
# OPENAI_API_KEY=

# --- Integrations (not implemented in V3.0.4) ---
# WHATSAPP_BUSINESS_TOKEN=
